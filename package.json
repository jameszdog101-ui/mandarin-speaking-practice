{
  "name": "mandarin-speaking-practice",
  "version": "1.1.0",
  "private": true,
  "description": "語言口語練習平台",
  "scripts": {
    "start": "node src/server.js",
    "dev": "wrangler dev",
    "dev:node": "node --watch src/server.js",
    "test": "node --test",
    "cf:migrate:local": "wrangler d1 migrations apply mandarin-speaking-practice --local",
    "cf:migrate:remote": "wrangler d1 migrations apply mandarin-speaking-practice --remote",
    "cf:migrate:staging": "wrangler d1 migrations apply mandarin-speaking-practice-staging --remote --env staging",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "^4.45.0"
  }
}
